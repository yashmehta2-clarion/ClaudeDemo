@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    ViewData["BoxClass"] = "register";
    Layout = "_AuthLayout";
}
<p class="register-box-msg">Register a new account</p>

<form asp-action="Register" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

    <div class="row g-2">
        <div class="col-sm-6 mb-2">
            <div class="form-floating">
                <input asp-for="FirstName" class="form-control" placeholder="" autocomplete="given-name" autofocus />
                <label asp-for="FirstName"></label>
            </div>
            <span asp-validation-for="FirstName" class="text-danger small"></span>
        </div>
        <div class="col-sm-6 mb-2">
            <div class="form-floating">
                <input asp-for="LastName" class="form-control" placeholder="" autocomplete="family-name" />
                <label asp-for="LastName"></label>
            </div>
            <span asp-validation-for="LastName" class="text-danger small"></span>
        </div>
    </div>

    <div class="mb-2">
        <div class="input-group">
            <div class="form-floating">
                <input asp-for="Email" class="form-control" placeholder="" autocomplete="email" />
                <label asp-for="Email"></label>
            </div>
            <div class="input-group-text"><span class="bi bi-envelope"></span></div>
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-2">
        <div class="form-floating">
            <select asp-for="Role" asp-items="ViewBag.Roles" class="form-select">
                <option value="">-- Select role --</option>
            </select>
            <label asp-for="Role"></label>
        </div>
        <span asp-validation-for="Role" class="text-danger small"></span>
    </div>

    <div class="mb-2">
        <div class="input-group">
            <div class="form-floating">
                <input asp-for="Password" class="form-control" placeholder="" autocomplete="new-password" />
                <label asp-for="Password"></label>
            </div>
            <div class="input-group-text"><span class="bi bi-lock-fill"></span></div>
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
        <div class="form-text">At least 8 characters, with upper-case, lower-case and a digit.</div>
    </div>

    <div class="mb-3">
        <div class="input-group">
            <div class="form-floating">
                <input asp-for="ConfirmPassword" class="form-control" placeholder="" autocomplete="new-password" />
                <label asp-for="ConfirmPassword"></label>
            </div>
            <div class="input-group-text"><span class="bi bi-lock-fill"></span></div>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <div class="d-grid">
        <button type="submit" class="btn btn-primary">Register</button>
    </div>
</form>

<p class="mb-0 mt-3">
    <a asp-action="Login" class="text-center">I already have an account</a>
</p>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
