@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_AuthLayout";
}
<h4 class="text-danger"><i class="bi bi-exclamation-octagon"></i> Something went wrong.</h4>
<p>An error occurred while processing your request.</p>
@if (Model.ShowRequestId)
{
    <p class="small text-secondary">Request ID: <code>@Model.RequestId</code></p>
}
<a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a>
